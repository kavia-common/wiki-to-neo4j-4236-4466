# Create a .env file at the project root (same folder as package.json) and fill in these values.

# Base URL of the backend API, e.g. http://localhost:8000 or https://api.example.com
REACT_APP_API_BASE_URL=http://localhost:8000

# HTTP Basic Auth credentials for the backend API
REACT_APP_API_BASIC_USER=your_api_username
REACT_APP_API_BASIC_PASS=your_api_password
